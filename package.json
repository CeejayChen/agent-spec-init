{
  "name": "agent-spec-init",
  "version": "0.1.0",
  "description": "Initialize an AI agent development specification system in any project — layered AGENTS.md, Agent Notes RFC/ADR, Skills, and machine-checkable verify gates.",
  "type": "module",
  "bin": {
    "agent-spec-init": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "scripts": {
    "build": "tsc && node scripts/copy-templates.mjs",
    "dev": "tsx src/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "tsc --noEmit",
    "verify-agent-note-format": "tsx scripts/verify-agent-note-format.ts",
    "verify-agent-note-classification": "tsx scripts/verify-agent-note-classification.ts",
    "verify-md-links": "tsx scripts/verify-md-links.ts",
    "verify-md-wrap": "tsx scripts/verify-md-wrap.ts",
    "verify-doc-budgets": "tsx scripts/verify-doc-budgets.ts",
    "verify-export-jsdoc": "tsx scripts/verify-export-jsdoc.ts",
    "verify-translation-pairing": "tsx scripts/verify-translation-pairing.ts --all",
    "doc-sync": "tsx scripts/run-gates.ts doc-sync",
    "test:docs": "tsx scripts/run-gates.ts doc-quick"
  },
  "keywords": [
    "agent",
    "specification",
    "ai",
    "development",
    "adr",
    "scaffolding",
    "cli"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@clack/prompts": "^0.10.0",
    "commander": "^13.1.0"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^3.2.0",
    "@types/node": "^22.0.0"
  }
}
